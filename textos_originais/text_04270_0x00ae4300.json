    },
    {
      "id": 17,
      "en": "Ritengo che sia da questa parte.",
      "pt_br": ""
    },
    {
      "id": 18,
      "en": "Ahimè! Da queste parti, di tesori nemmeno l'ombra.",
      "pt_br": ""
    },
    {
      "id": 19,
      "en": "Presumo che si trovi di là.",
      "pt_br": ""
    },
    {
      "id": 20,
      "en": "È poco distante, questo è certo!",
      "pt_br": ""
    },
    {
      "id": 21,
      "en": "È tutto pronto per il tragitto?",
      "pt_br": ""
    },
    {
      "id": 22,
      "en": "Ahimè, purtroppo non si può procedere...",
      "pt_br": ""
    },
    {
      "id": 23,
      "en": "È un po' troppo distante...",
      "pt_br": ""
    },
    {
      "id": 24,
      "en": "Ti ringrazio per il tuo dono!",
      "pt_br": ""
    },
    {
