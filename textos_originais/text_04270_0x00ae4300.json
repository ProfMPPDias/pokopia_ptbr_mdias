    {
      "id": 2,
      "en": "A un lungo e fruttuoso sodalizio!",
      "pt_br": ""
    },
    {
      "id": 3,
      "en": "Pregusto già l'opera finita!",
      "pt_br": ""
    },
    {
      "id": 4,
      "en": "Ancora non si vede la fine dei lavori!",
      "pt_br": ""
    },
    {
      "id": 5,
      "en": "Siamo quasi in procinto di concludere l'opera!",
      "pt_br": ""
    },
    {
      "id": 6,
      "en": "È stato un gran diletto.",
      "pt_br": ""
    },
    {
      "id": 7,
      "en": "Piove... Sarà bene rincasare.",
      "pt_br": ""
    },
    {
      "id": 8,
      "en": "Sembra una vera leccornia!",
      "pt_br": ""
    },
    {
      "id": 9,
      "en": "Dove si cela il tesoro...?",
      "pt_br": ""
    },
    {
      "id": 10,
      "en": "Temo di non riuscire a raggiungere quel posto...",
      "pt_br": ""
    },
    {
      "id": 11,
      "en": "Le mie povere e stanche membra...",
      "pt_br": ""
    },
    {
      "id": 12,
      "en": "Finalmente giungo alla meta!",
      "pt_br": ""
    },
    {
      "id": 13,
      "en": "Il passaggio non è dei più agevoli...",
      "pt_br": ""
    },
    {
      "id": 14,
      "en": "È qui, non c'è dubbio.",
      "pt_br": ""
    },
    {
      "id": 15,
      "en": "Ne deduco che si trovi qui sopra.",
      "pt_br": ""
    },
    {
      "id": 16,
      "en": "Propongo di scavare qui sotto.",
