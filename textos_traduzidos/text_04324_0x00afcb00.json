    },
    {
      "id": 2,
      "en": "Diamoci da fare!",
      "pt_br": "Diamoci da fare!"
    },
    {
      "id": 3,
      "en": "Forza!",
      "pt_br": "Forza!"
    },
    {
      "id": 4,
      "en": "Manca il tocco finale!",
      "pt_br": "Manca il tocco finale!"
    },
    {
      "id": 5,
      "en": "Ci siamo!",
      "pt_br": "Ci siamo!"
    },
    {
      "id": 6,
      "en": "Mmh... Ho l'acquolina in bocca.",
      "pt_br": "Mmh... Ho l'acquolina in bocca."
    },
    {
      "id": 7,
      "en": "Che bella casa!",
      "pt_br": "Che bella casa!"
    },
    {
      "id": 8,
      "en": "In marcia, allora!",
      "pt_br": "In marcia, allora!"
    },
    {
      "id": 9,
      "en": "Arrivederci!",
      "pt_br": "Arrivederci!"
    },
    {
      "id": 10,
      "en": "Vedrò di darmi da fare!",
      "pt_br": "Vedrò di darmi da fare!"
    },
    {
      "id": 11,
      "en": "Mi sono fatto allettare da questo buon profumo!",
      "pt_br": "Mi sono fatto allettare da questo buon profumo!"
    },
    {
      "id": 12,
      "en": "Al momento non posso.",
      "pt_br": "Al momento non posso."
    },
    {
      "id": 13,
      "en": "Cos'hai con te?",
      "pt_br": "Cos'hai con te?"
    },
    {
      "id": 14,
      "en": "Non riesco a muovermi per la fame...",
      "pt_br": "Non riesco a muovermi per la fame..."
    },
    {
      "id": 15,
      "en": "Ci sarà qualcuno lì?",
      "pt_br": "Ci sarà qualcuno lì?"
    },
    {
      "id": 16,
      "en": "Notevole!",
      "pt_br": "Notevole!"
    },
    {
      "id": 17,
      "en": "Questo caldo fa bene alle mie vecchie ossa.",
      "pt_br": "Questo caldo fa bene alle mie vecchie ossa."
    },
    {
      "id": 18,
      "en": "Ho un'età! Non riesco a starti dietro!",
      "pt_br": "Ho un'età! Non riesco a starti dietro!"
    },
    {
      "id": 19,
      "en": "Mi fremono le braccia!",
      "pt_br": "Mi fremono le braccia!"
    },
    {
      "id": 20,
      "en": "Mi è venuto un languorino.",
      "pt_br": "Mi è venuto un languorino."
    },
    {
      "id": 21,
      "en": "Non sto più nella pelle!",
      "pt_br": "Non sto più nella pelle!"
    },
    {
      "id": 22,
      "en": "Non vedo l'ora di mettermi al lavoro!",
      "pt_br": "Non vedo l'ora di mettermi al lavoro!"
    },
    {
      "id": 23,
      "en": "Allora, si comincia?",
      "pt_br": "Allora, si comincia?"
    },
    {
      "id": 24,
      "en": "Abbiamo fatto un buon lavoro!",
      "pt_br": "Abbiamo fatto un buon lavoro!"
    },
    {
      "id": 25,
      "en": "Ma che bel posticino!",
      "pt_br": "Ma che bel posticino!"
